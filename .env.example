# Copy to .env and fill in. Never commit .env.

# --- Core ---------------------------------------------------------------
DATABASE_URL=sqlite:///./editalis.db
# Postgres (production): postgresql+psycopg://user:pass@postgres:5432/editalis
LOG_LEVEL=INFO
# Required for the /subscribers admin endpoints (sent as the X-Admin-Token header).
ADMIN_TOKEN=

# --- Classification -------------------------------------------------------
# Leave empty to use the heuristic classifier.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-sonnet-4-6
# Longer documents are truncated before being sent to the LLM.
CLASSIFIER_MAX_CHARS=20000

# --- WhatsApp -------------------------------------------------------------
# 1 = log messages to the console instead of sending them.
DRY_RUN=1
# meta | evolution
WA_PROVIDER=meta

# Meta Cloud API
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Approved template with a single body variable {{1}}.
WA_TEMPLATE_NAME=editalis_alert
WA_TEMPLATE_LANG=pt_BR
# Token you choose; Meta echoes it during the webhook handshake.
WA_VERIFY_TOKEN=
# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
WA_APP_SECRET=

# Evolution API (self-hosted)
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- Worker ---------------------------------------------------------------
SCHEDULE_MINUTES=30
FREE_DELAY_HOURS=24
CLASSIFY_BATCH_SIZE=200
DISPATCH_BATCH_SIZE=200

# --- Sources --------------------------------------------------------------
QD_BASE_URL=https://api.queridodiario.org.br
QD_QUERY="concurso público"
QD_LOOKBACK_DAYS=2
QD_PAGE_SIZE=100
QD_MAX_PAGES=10
# Comma-separated list. Only feeds whose terms allow this use.
RSS_FEEDS=

# --- Monetization ---------------------------------------------------------
# JSON object: area -> course affiliate URL. Areas: administrative, banking,
# education, engineering, health, it, legal, security, tax, other.
AFFILIATE_LINKS={}
